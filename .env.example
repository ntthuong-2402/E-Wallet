# Copy this file to .env and replace the value before the first startup.
# The real .env file is ignored by Git and excluded from the Docker build context.
ADMIN_BOOTSTRAP_INITIAL_PASSWORD=replace-with-a-strong-temporary-password
AUTHENTICATION_JWT_SECRET=replace-with-a-unique-secret-at-least-32-characters
PAYMENT_LEDGER_DB=Host=postgres;Port=5432;Database=friday;Username=payment_ledger_runtime;Password=replace-with-a-strong-runtime-password
PAYMENT_LEDGER_MIGRATION_DB=Host=postgres;Port=5432;Database=friday;Username=payment_ledger_owner;Password=replace-with-a-strong-migration-password
CUSTOMER_AUDIT_RETENTION_DAYS=365
# Leave empty while retention runs in dry-run mode. Use the dedicated retention
# database role before enabling destructive purge.
CUSTOMER_RETENTION_DB=
